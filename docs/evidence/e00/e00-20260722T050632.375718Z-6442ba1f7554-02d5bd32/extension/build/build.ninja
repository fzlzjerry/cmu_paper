ninja_required_version = 1.3
cxx = /usr/bin/c++
nvcc = /usr/local/cuda-13.0/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=e00_cuda_cert -DTORCH_API_INCLUDE_EXTENSION_H -isystem /home/rockrock/cmu_paper/.venv/lib/python3.12/site-packages/torch/include -isystem /home/rockrock/cmu_paper/.venv/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -isystem /usr/local/cuda-13.0/include -isystem /usr/include/python3.12 -fPIC -std=c++20 -O2 -std=c++20
post_cflags = 
cuda_cflags = -ccbin /usr/bin/gcc -DTORCH_EXTENSION_NAME=e00_cuda_cert -DTORCH_API_INCLUDE_EXTENSION_H -isystem /home/rockrock/cmu_paper/.venv/lib/python3.12/site-packages/torch/include -isystem /home/rockrock/cmu_paper/.venv/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -isystem /usr/local/cuda-13.0/include -isystem /usr/include/python3.12 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options '-fPIC' -O2 -std=c++20 -lineinfo -gencode=arch=compute_120,code=sm_120 -gencode=arch=compute_120,code=compute_120
cuda_post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/home/rockrock/cmu_paper/.venv/lib/python3.12/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/usr/local/cuda-13.0/lib64 -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc -MD -MF $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





rule link
  command = $cxx $in $ldflags -o $out

build binding.o: compile /home/rockrock/cmu_paper/preflight/e00_cuda/binding.cpp
build xor_kernel.cuda.o: cuda_compile /home/rockrock/cmu_paper/preflight/e00_cuda/xor_kernel.cu





build e00_cuda_cert.so: link binding.o xor_kernel.cuda.o

default e00_cuda_cert.so
